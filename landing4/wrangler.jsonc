// Landing "Operaciones reales" · Invierte con Respaldo Inmobiliario (Pulso Inversor).
// Worker + D1, publicado solo en 4.pulsoinversor.cl.
// Secretos (no van en este archivo): BREVO_API_KEY y CLAVE_PANEL → `npx wrangler secret put NOMBRE`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulso-landing-operaciones",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pulso-landing-operaciones",
      "database_id": "3e6a9b0d-f9de-48ba-991a-6eb26e4ecc37"
    }
  ],
  "routes": [
    { "pattern": "4.pulsoinversor.cl", "custom_domain": true }
  ],
  "vars": {
    "REMITENTE_NOMBRE": "Pulso Inversor",
    "REMITENTE_EMAIL": "contacto@pulsoinversor.cl",
    "RESPONDER_A": "contacto@pulsoinversor.cl",
    // Aviso de cada nuevo interesado al equipo (separar con coma).
    "AVISO_EQUIPO_EMAIL": "ibarboza@grupomm.cl, frojas@grupomm.cl, jvalenzuela@grupomm.cl, eorrego@grupomm.cl, ibarboza@pulsoinversor.cl, frojas@pulsoinversor.cl"
  },
  "observability": { "enabled": true }
}
