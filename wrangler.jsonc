// Prototipo 1 (rama main): sitio estático servido desde la raíz del repositorio.
// Se publica en www.pulsoinversor.cl. pulsoinversor.cl y las páginas de 1.pulsoinversor.cl redirigen a www (ver worker/index.js);
// 1.pulsoinversor.cl sigue atendiendo /api, /seguimiento y /panel. La dirección workers.dev está desactivada.
// run_worker_first: true para que el Worker pueda redirigir antes de servir los archivos.
// worker/index.js atiende /api/enviar-simulacion y /seguimiento/* (correos con Brevo); todo lo demás son archivos estáticos.
// Los archivos que no se publican están en .assetsignore.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulsoinversor",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "1.pulsoinversor.cl", "custom_domain": true },
    { "pattern": "presentacion.pulsoinversor.cl", "custom_domain": true },
    { "pattern": "www.pulsoinversor.cl/*", "zone_name": "pulsoinversor.cl" },
    { "pattern": "pulsoinversor.cl/*", "zone_name": "pulsoinversor.cl" }
  ],
  // Recordatorios de reuniones (24 h, 1 h y 1 minuto antes).
  "triggers": { "crons": ["* * * * *"] },
  // Base de simulaciones y seguimiento (panel en /panel). Esquema en worker/schema.sql.
  "d1_databases": [
    { "binding": "DB", "database_name": "pulso-simulaciones", "database_id": "fbeffb74-286a-4f0f-8e71-6695e7a079f2" }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
