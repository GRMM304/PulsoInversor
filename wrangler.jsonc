// Prototipo 1 (rama main): sitio estático servido desde la raíz del repositorio.
// Se publica solo en 1.pulsoinversor.cl (la dirección workers.dev está desactivada).
// worker/index.js atiende /api/enviar-simulacion y /seguimiento/* (correos con Brevo); todo lo demás son archivos estáticos.
// Los archivos que no se publican están en .assetsignore.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulsoinversor",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "1.pulsoinversor.cl", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/seguimiento/*"]
  }
}
