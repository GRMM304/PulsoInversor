// Prototipo 2: contenido del sitio V5 con el diseño del Prototipo 1.
// Se publica aparte del Prototipo 1 (rama main) en pulsoinversor-prototipo2.<cuenta>.workers.dev.
// Regenerar: python3 aplicar_diseno.py  ·  Publicar: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulsoinversor-prototipo2",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
