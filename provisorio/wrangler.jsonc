// Cloudflare Workers: sitio provisorio de Pulso Inversor (solo archivos estáticos).
// Proyecto aparte del sitio nuevo (raíz del repo): en Cloudflare usar
// "Root directory" = provisorio y la rama sitio-provisorio.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulsoinversor-provisorio",
  "compatibility_date": "2025-09-01",
  // pulsoinversor.cl y www (registros proxied en Cloudflare) se sirven con este Worker.
  "routes": [
    { "pattern": "pulsoinversor.cl/*", "zone_name": "pulsoinversor.cl" },
    { "pattern": "www.pulsoinversor.cl/*", "zone_name": "pulsoinversor.cl" }
  ],
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
